# Copy to .env.local and fill in. Without a key the app runs in keyword-search mode.
OPENAI_API_KEY=

# Optional: any OpenAI-compatible endpoint (LiteLLM gateway, Azure via proxy, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the models. Check your provider's current model list.
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
